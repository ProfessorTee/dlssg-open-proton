[Desktop Entry]
Type=Application
Name=Create dlssg-open Proton
Name[de]=dlssg-open Proton erstellen
Comment=Create a Proton copy with DLSS Frame Generation (RTX 30)
Comment[de]=Proton-Kopie mit DLSS Frame Generation (RTX 30) anlegen
Exec=dlssg-open-proton
Icon=steam
Terminal=false
Categories=Game;
Actions=game;folder;

[Desktop Action game]
Name=Install / update dlssg_for_sm86 in a game
Name[de]=dlssg_for_sm86 in ein Spiel installieren / aktualisieren
Exec=dlssg-open-proton --game

[Desktop Action folder]
Name=Open Proton folder
Name[de]=Proton-Ordner öffnen
Exec=dlssg-open-proton --folder
