#!/usr/bin/env bash
# Mini-GUI: copies an installed Proton build into a separate compat tool with
# dlssg-open (DLSS frame generation on RTX 30) installed, using the newest release.
set -euo pipefail

STEAM="$HOME/.local/share/Steam"
DEST="$STEAM/compatibilitytools.d"
CACHE="$HOME/.cache/dlssg-open"
REPO="dniminenn/dlssg-open"
TITLE="dlssg-open Proton"
LAUNCH="DXVK_NVAPI_GPU_ARCH=AD100 NVCUDA_LITE_CC=8.9 DXVK_NVAPI_CUBIN_RETARGET_SM=86"

[[ "${1:-}" == --folder ]] && exec xdg-open "$DEST"

# German UI on a German system, English otherwise: t "deutsch" "english"
[[ "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" == de* ]] && DE=1 || DE=
t() { if [[ $DE ]]; then printf %s "$1"; else printf %s "$2"; fi; }

fail() { kdialog --title "$TITLE" --error "$1"; exit 1; }

# Installed Proton builds that dlssg-open can patch (nvapi + nvcuda present), minus our own copies.
items=()
for d in "$STEAM"/steamapps/common/Proton* /usr/share/steam/compatibilitytools.d/* "$DEST"/*; do
    [[ -f "$d/proton" && -f "$d/files/lib/wine/nvapi/x86_64-windows/nvapi64.dll" ]] || continue
    [[ "$d" == *-dlssg-open* ]] && continue
    items+=("$d" "$(basename "$d")" off)
done
((${#items[@]})) || fail "$(t "Keine passende Proton-Version gefunden." "No suitable Proton build found.")"

src=$(kdialog --title "$TITLE" --radiolist "$(t "Welche Proton-Version soll den Mod bekommen?" "Which Proton build should get the mod?")" "${items[@]}") || exit 0

# Newest release of the mod
rel=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest") || fail "$(t "GitHub nicht erreichbar." "GitHub not reachable.")"
read -r tag url < <(python3 -I -c 'import json,sys; d=json.load(sys.stdin); print(d["tag_name"], d["assets"][0]["browser_download_url"])' <<<"$rel")
pkg="$CACHE/$tag"
if [[ ! -f "$pkg/.ok" ]]; then
    rm -rf "$pkg"; mkdir -p "$pkg"
    curl -fsSL -o "$pkg/release.tar.gz" "$url" || fail "$(t "Download von $tag fehlgeschlagen." "Download of $tag failed.")"
    tar -xzf "$pkg/release.tar.gz" -C "$pkg"
    sumdir=$(dirname "$(find "$pkg" -name SHA256SUMS | head -1)")
    (cd "$(dirname "$sumdir")" && sha256sum -c --quiet "$sumdir/SHA256SUMS") || fail "$(t "Prüfsummen von $tag stimmen nicht." "Checksums of $tag do not match.")"
    touch "$pkg/.ok"
fi
installer=$(find "$pkg" -name install.py | head -1)

name="$(basename "$src")-dlssg-open-$tag"
target="$DEST/$name"
if [[ -e "$target" ]]; then
    kdialog --title "$TITLE" --warningyesno "$(t "$name existiert schon. Neu erstellen?" "$name already exists. Recreate it?")" || exit 0
    rm -rf -- "$target"
fi

kdialog --title "$TITLE" --passivepopup "$(t "Kopiere $(basename "$src") … (kann etwas dauern)" "Copying $(basename "$src") … (may take a while)")" 5
nice -n 19 cp -a --reflink=auto "$src" "$target"

# Own manifest so Steam lists the copy as a separate tool (Valve's toolmanifest.vdf stays for the runtime)
cat > "$target/compatibilitytool.vdf" <<EOF
"compatibilitytools"
{
  "compat_tools"
  {
    "$name"
    {
      "install_path" "."
      "display_name" "$(basename "$src") (dlssg-open $tag)"
      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
  }
}
EOF

log=$(python3 -I "$installer" --proton "$target" 2>&1) || { rm -rf -- "$target"; fail "$(t "Installation fehlgeschlagen:" "Installation failed:")"$'\n'"$log"; }

done_de="Fertig: $(basename "$src") (dlssg-open $tag)

1. Steam neu starten
2. Im Spiel unter Kompatibilität die neue Version wählen
3. In die Launch-Optionen vor %command%:
$LAUNCH

Nicht dazu: PROTON_NVIDIA_LIBS / PROTON_NVIDIA_NVCUDA"
done_en="Done: $(basename "$src") (dlssg-open $tag)

1. Restart Steam
2. Select the new build under Compatibility in the game's properties
3. Put this in the launch options before %command%:
$LAUNCH

Do not add: PROTON_NVIDIA_LIBS / PROTON_NVIDIA_NVCUDA"
kdialog --title "$TITLE" --yes-label "$(t "Proton-Ordner öffnen" "Open Proton folder")" --no-label "$(t "Schließen" "Close")" \
    --yesno "$(t "$done_de" "$done_en")" && xdg-open "$DEST"
